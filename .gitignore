# Vite + React .gitignore
# Keep repo clean: ignore dependencies, build outputs, local env, and editor/OS junk

#########################
# OS / editor / tooling
#########################
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# VSCode
.vscode/
!.vscode/extensions.json

# JetBrains
.idea/

# Misc editor swap files
*.swp
*~
*.swo

#########################
# Node dependencies
#########################
node_modules/

# package manager debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

#########################
# Vite / build outputs
#########################
dist/
build/
out/
.vite/
.cache/
.parcel-cache/

#########################
# Coverage / test outputs
#########################
coverage/
.nyc_output/
*.lcov
*.lcov.info
report.json

#########################
# Environment variables / secrets
#########################
# Ignore local env files, but keep .env.example
.env
.env.*
!.env.example

# Common local override files (safe to ignore if present)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Firebase / service credentials (only ignore if you commit them as local secrets)
.firebase/
serviceAccountKey.json

# Private keys (avoid committing)
*.pem
*.key
*.p12
*.jks
*.pfx
*.crt
*.csr
id_rsa
id_rsa.pub

# End

